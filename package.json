		"@vue/server-test-utils": "^1.3.0",
		"@vue/test-utils": "^2.4.9",
		"clean-pkg-json": "^1.2.0",
		"expect-type": "^1.3.0",
		"jsdom": "^22.0.0",
		"lintroll": "^1.30.0",
		"outdent": "^0.8.0",
		"rollup": "^3.22.0",
		"rollup-plugin-filesize": "^10.0.0",
		"typescript": "^6.0.2",
		"vite": "^4.3.7",
		"vitest": "^0.31.0",
		"vue": "^2.7.14",
		"vue-server-renderer": "^2.7.14",
		"vue-template-compiler": "^2.7.14"
	}
